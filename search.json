---
layout: null
permalink: /search.json
sitemap: false
---

{%- assign posts = site.posts | where_exp: 'p', 'p.draft != true' | sort: 'date' | reverse -%}
[
{%- for post in posts -%}
  {
    "title": {{ post.title | strip_html | jsonify }},
    "url":   {{ post.url   | relative_url | jsonify }},
    "date":  {{ post.date  | date: "%b %-d, %Y" | jsonify }},
    "tags":  {{ post.tags  | uniq | jsonify }},
    "excerpt": {{ post.excerpt | default: post.content | strip_html | normalize_whitespace | truncate: 180 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
